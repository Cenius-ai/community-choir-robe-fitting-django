# Copy to .env for local overrides — every value is optional.
# install.sh creates .env with a generated SECRET_KEY on a fresh checkout,
# and the app also boots with no .env at all thanks to safe development defaults.

# Django signing key. Secret-shaped: leave blank to use the in-code dev fallback.
SECRET_KEY=

# Verbose error pages locally (set false for a real deployment).
DJANGO_DEBUG=true

# Host header allowlist; "*" keeps the sandbox/preview reachable.
DJANGO_ALLOWED_HOSTS=*

# Comma-separated scheme://host origins allowed to POST (only needed behind TLS/proxies).
DJANGO_CSRF_ORIGINS=

# Datastore. Defaults to a SQLite file next to manage.py.
DATABASE_URL=sqlite:///./db.sqlite3
